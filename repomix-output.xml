  <button data-act="delsub" style="width:100%">${armed=='sub'+u.id?'Tap again to delete this subject':'Delete subject'}</button>`}
function cPlan(){const c=S.c;
  return hdr('main','Weekly study plan')+(c.subs.length?'':'<p class="mu">Add a semester and subjects first, then plan them here.</p>')+ORDER.map(d=>{const pl=c.plan[d]||[];
    return `<div class="card"><h3>${DN[d]} · ${pl.reduce((a,i)=>a+i.h,0)}h</h3>${pl.map((i,n)=>`<div class="row"><select data-act="pset" data-d="${d}" data-i="${n}" data-f="s" style="flex:1">${c.subs.map(u=>`<option value="${u.id}" ${u.id==i.s?'selected':''}>${esc(u.n)}</option>`).join('')}</select><input type="number" step="0.5" min="0" value="${i.h}" data-act="pset" data-d="${d}" data-i="${n}" data-f="h" style="width:70px"><button data-act="pdel" data-d="${d}" data-i="${n}">✕</button></div>`).join('')}<button data-act="padd" data-d="${d}" style="width:100%;margin-top:6px">+ Add subject</button></div>`}).join('')}
function colClick(b,a){const c=S.c,d=b.dataset;if(!/^del(f|sub|sem|tp)$/.test(a))armed=null;
  if(a=='cgo'){cv=d.v;err=''}
  else if(a=='osub'){const u=sub(d.id);selSub=u.id;selSem=u.sem;cv='sub';err=''}
  else if(a=='osem'){selSem=d.id;cv='sem'}
