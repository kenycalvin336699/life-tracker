function selfPlan(d){const dn=day(d).pdone||{},k=dk(d),it=S.f.topics.filter(x=>((x.sch||{})[k]||{}).h>0).map(x=>({x,h:x.sch[k].h,at:x.sch[k].at||''})).sort((a,b)=>(a.at||'99').localeCompare(b.at||'99'));
  return{it,dn,t:it.reduce((a,i)=>a+i.h,0),d:it.filter(i=>dn[i.x.id]).reduce((a,i)=>a+i.h,0)}}
function selfTile(){const p=selfPlan(cur);return `<div class="ic">🧠</div><h2>Self</h2><div class="pc">${p.t?p.d+'/'+p.t+'h':'—'}</div><small>${p.t?'growth today':'set plan'}</small>`}
function vSelf(){return(sv=='topic'?sTop:sMain)()}
function sMain(){const f=S.f,p=selfPlan(cur);
  return `<div class="card"><small>SELF · GROWTH QUEST</small><div class="big">${p.d}/${p.t}h</div><div class="bar"><i style="width:${p.t?Math.round(100*p.d/p.t):0}%"></i></div>
