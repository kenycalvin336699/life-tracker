<body>
<main id="v"><p class="mu">Loading…</p></main>
<nav id="nav"></nav>
<div id="off" style="display:none;position:fixed;left:0;right:0;top:0;background:#7a1730;color:#fff;text-align:center;padding:4px;font-size:13px;z-index:9">Server offline. Changes will save when it is back.</div>
<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const parse=s=>{const[a,b,c]=s.split('-').map(Number);return new Date(a,b-1,c)};
const addD=(s,n)=>{const d=parse(s);d.setDate(d.getDate()+n);return iso(d)};
const shiftMon=(m,n)=>{const[y,mo]=m.split('-').map(Number);return iso(new Date(y,mo-1+n,1)).slice(0,7)};
const fmt=n=>'₹'+Math.round(n).toLocaleString('en-IN');
const uid0=()=>Math.random().toString(36).slice(2,8);
const DAYS=['sun','mon','tue','wed','thu','fri','sat'],ORDER=['mon','tue','wed','thu','fri','sat','sun'],DN={sun:'Sunday',mon:'Monday',tue:'Tuesday',wed:'Wednesday',thu:'Thursday',fri:'Friday',sat:'Saturday'};
let cur=iso(new Date()),tab='home',rng='week',mon=cur.slice(0,7),store=null,editing=false,editDay='mon';
const S={s:null,days:{},money:{}};
const DEF=()=>{const ex={},fd={};DAYS.forEach(k=>{ex[k]=k=='sun'?['Rest']:['Warm-up','Workout','Stretch'];fd[k]=['Breakfast','Lunch','Snack','Dinner']});return{wake:'05:30',sleep:'22:00',wmin:2,wmax:3,protein:100,budget:0,ex,fd}};
const dk=d=>DAYS[parse(d).getDay()];
const isRest=l=>!l.length||/^rest/i.test(l[0]);
const tm=t=>{const[h,m]=t.split(':').map(Number);return(h%12||12)+':'+String(m).padStart(2,'0')+(h<12?' AM':' PM')};
const lines=v=>v.split('\n').map(x=>x.trim()).filter(Boolean);

async function init(){try{const r=await fetch('/api/ping');store=r.ok}catch(e){}
  A={upload:async f=>{const r=await fetch('/api/files',{method:'POST',headers:{'Content-Type':f.type||'application/pdf','X-Filename':encodeURIComponent(f.name)},body:f});if(!r.ok)throw new Error('upload');return r.json()},delete:id=>fetch('/api/files/'+id,{method:'DELETE'})}}
async function load(n,def){try{const r=await fetch('/api/doc/'+n);if(r.status==404)return def;if(r.ok)return await r.json()}catch(e){}try{const v=localStorage.getItem('lt:'+n);return v?JSON.parse(v):def}catch(e){return def}}
const timers={},pend={};
function banner(){const b=$('#off');if(b)b.style.display=Object.keys(pend).length?'block':'none'}
function flush(){Object.keys(pend).forEach(n=>{const o=pend[n];fetch('/api/doc/'+n,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(o)}).then(r=>{if(!r.ok)throw 0;if(pend[n]===o)delete pend[n];banner()}).catch(banner)});banner()}
function save(n,o){try{localStorage.setItem('lt:'+n,JSON.stringify(o))}catch(e){}pend[n]=o;clearTimeout(timers[n]);timers[n]=setTimeout(flush,400)}
setInterval(()=>{if(Object.keys(pend).length)flush()},5000);
document.addEventListener('visibilitychange',()=>{if(document.hidden){Object.keys(timers).forEach(k=>clearTimeout(timers[k]));flush()}});
const ensureYear=async y=>{if(!S.days[y])S.days[y]=(await load('days-'+y,{days:{}})).days||{}};
const ensureMon=async m=>{if(!S.money[m])S.money[m]=(await load('money-'+m,{items:[]})).items||[]};
const saveDays=y=>save('days-'+y,{days:S.days[y]}),saveMoney=m=>save('money-'+m,{items:S.money[m]}),saveSet=()=>save('health',S.s);

const day=d=>(S.days[d.slice(0,4)]||{})[d]||{};
function setDay(d,p){const y=d.slice(0,4);S.days[y]=S.days[y]||{};const o=S.days[y][d]||{done:{}};if(!o.done)o.done={};S.days[y][d]=Object.assign(o,p);saveDays(y)}
function items(d){const s=S.s,k=dk(d),e=isRest(s.ex[k])?[]:s.ex[k];return[{k:'wake'},{k:'sleep'},...e.map(t=>({k:'e:'+t})),...s.fd[k].map(t=>({k:'f:'+t}))]}
function pct(d){const x=day(d),dn=x.done||{},it=items(d);return Math.round(100*(it.filter(i=>dn[i.k]).length+((x.water||0)>=S.s.wmin?1:0))/(it.length+1))}
function streak(){let d=cur,n=0;if(pct(d)<80)d=addD(d,-1);while(n<400&&pct(d)>=80){n++;d=addD(d,-1)}return n}
function xp(){let x=0;for(const y in S.days)for(const d in S.days[y]){const o=S.days[y][d];x+=(Object.values(o.done||{}).filter(Boolean).length+Object.values(o.sdone||{}).filter(Boolean).length+Object.values(o.pdone||{}).filter(Boolean).length)*10;if((o.water||0)>=S.s.wmin)x+=10}return x}
const sum=(it,t)=>it.filter(i=>i.t==t).reduce((a,i)=>a+i.a,0);

const chk=(k,l,dn)=>`<label class="row"><input type="checkbox" data-act="chk" data-k="${esc(k)}" ${dn[k]?'checked':''}><span class="${dn[k]?'dn':''}">${esc(l)}</span></label>`;
function meter(k,l,u,steps,v,goal,min){const p=Math.min(100,Math.round(100*v/goal));
  return `<div class="row" style="border:0;padding-bottom:0"><span>${l}</span><span class="mu">${+v.toFixed(2)} / ${goal} ${u}</span></div><div class="bar"><i style="width:${p}%"></i>${min?`<b style="left:${100*min/goal}%"></b>`:''}</div><div class="st">${steps.map(s=>`<button data-act="step" data-k="${k}" data-s="${s}">${s>0?'+':'−'} ${Math.abs(s)}</button>`).join('')}</div>`}

function vHome(){const s=S.s,p=pct(cur),x=day(cur),X=xp(),lv=Math.floor(X/200)+1,bal=sum(S.money[cur.slice(0,7)]||[],'in')-sum(S.money[cur.slice(0,7)]||[],'out');
  return `<div class="card"><small>SYSTEM · PLAYER STATUS</small><div class="lv">LEVEL ${lv}</div><div class="bar"><i style="width:${(X%200)/2}%"></i></div><small>${X%200} / 200 XP · ${streak()} day streak</small></div>
  <div class="tiles">
  <button class="tile" data-act="go" data-t="health"><div class="ic">❤️</div><h2>Health</h2><div class="pc">${p}%</div><small>${+(x.water||0).toFixed(1)}/${s.wmax} L</small></button>
  <button class="tile" data-act="go" data-t="college">${colTile()}</button>
  <button class="tile" data-act="go" data-t="self">${selfTile()}</button></div>`}

function vHealth(){if(editing)return vEdit();const x=day(cur),s=S.s,k=dk(cur),dn=x.done||{},p=pct(cur),rest=isRest(s.ex[k]);
  return `<div class="card"><small>HEALTH · DAILY QUEST</small><div class="big">${p}%</div><div class="bar"><i style="width:${p}%"></i></div><small>${DN[k]}</small></div>
  <div class="card"><h3>Routine</h3>${chk('wake','Wake up at '+tm(s.wake),dn)}<div class="row"><span class="mu">Actual wake-up time</span><input type="time" data-act="wake" value="${x.wake||''}"></div>${chk('sleep','Sleep by '+tm(s.sleep),dn)}</div>
  <div class="card"><h3>Water · ${s.wmin} to ${s.wmax} L</h3>${meter('water','Water','L',[-0.25,0.25,0.5],x.water||0,s.wmax,s.wmin)}</div>
  <div class="card"><div class="row" style="border:0;padding:0 0 4px"><h3 style="margin:0">Exercise · ${DN[k]}</h3><button data-act="edit" style="padding:4px 10px">Edit</button></div>${rest?'<p class="mu" style="margin:0">Rest day. Recover and stretch lightly.</p>':s.ex[k].map(t=>chk('e:'+t,t,dn)).join('')}</div>
  <div class="card"><h3>Food · ${DN[k]}</h3>${s.fd[k].map(t=>chk('f:'+t,t,dn)).join('')||'<p class="mu">No meals planned.</p>'}<div style="height:8px"></div>${meter('protein','Protein','g',[-10,10,25],x.protein||0,s.protein)}</div>
  <button class="pri" style="width:100%" data-act="edit">Edit plans</button>`}

function vEdit(){const s=S.s,inp=(l,kk,t,v)=>`<div class="row"><span>${l}</span><input data-act="cfg" data-k="${kk}" type="${t}" ${t=='number'?'step="0.25"':''} value="${v}" style="width:110px"></div>`,
  blk=key=>ORDER.map(d=>`<small style="margin-top:6px">${DN[d]}</small><textarea id="${key}-${d}" style="min-height:${key=='ex'?84:70}px">${esc(s[key][d].join('\n'))}</textarea>`).join('');
  return `<div class="card"><h3>Exercise plan</h3><small>One exercise per line. Write Rest for a rest day.</small>${blk('ex')}</div>
  <div class="card"><h3>Food plan</h3><small>One item per line.</small>${blk('fd')}</div>
  <div class="card"><h3>Routine targets</h3>${inp('Wake up','wake','time',s.wake)}${inp('Sleep','sleep','time',s.sleep)}${inp('Water min (L)','wmin','number',s.wmin)}${inp('Water max (L)','wmax','number',s.wmax)}${inp('Protein (g)','protein','number',s.protein)}</div>
  <button class="pri" style="width:100%" data-act="saveplan">Save &amp; close</button>`}

function vStats(){let h=`<div class="seg">${['week','month','year'].map(r=>`<button data-act="rng" data-r="${r}" class="${rng==r?'on':''}">${r}</button>`).join('')}</div>`;
  if(rng=='week'){const ds=[...Array(7)].map((_,i)=>addD(cur,i-6)),a=k=>Math.round(ds.reduce((t,d)=>t+(day(d)[k]||0),0)/7*10)/10;
    h+=`<div class="card"><h3>Last 7 days</h3><div class="cols">${ds.map(d=>`<div class="col"><div class="cb"><i style="height:${pct(d)}%"></i></div><small>${parse(d).toLocaleDateString('en',{weekday:'short'})}</small><small>${pct(d)}%</small></div>`).join('')}</div></div>
    <div class="card grid"><div><b>${Math.round(ds.reduce((t,d)=>t+pct(d),0)/7)}%</b><small>avg score</small></div><div><b>${a('water')}</b><small>avg water L</small></div><div><b>${a('protein')}</b><small>avg protein g</small></div><div><b>${streak()}</b><small>day streak</small></div></div>`;
  }else if(rng=='month'){const m=cur.slice(0,7),f=parse(m+'-01'),n=new Date(f.getFullYear(),f.getMonth()+1,0).getDate(),off=(f.getDay()+6)%7;let c='',t=0;
    ['M','T','W','T','F','S','S'].forEach(w=>c+=`<div class="h">${w}</div>`);for(let i=0;i<off;i++)c+='<div class="h"></div>';
    for(let i=1;i<=n;i++){const d=m+'-'+String(i).padStart(2,'0'),p=pct(d);t+=p;c+=`<div style="background:color-mix(in srgb,#38d6ff ${p}%,rgba(80,130,230,.15))">${i}</div>`}
    h+=`<div class="card"><h3>${f.toLocaleDateString('en',{month:'long',year:'numeric'})}</h3><div class="cal">${c}</div></div><div class="card"><b>${Math.round(t/n)}%</b> <span class="mu">average score · ${streak()} day streak</span></div>`;
  }else{const y=cur.slice(0,4),all=S.days[y]||{};let cols='';
    for(let m=1;m<=12;m++){const k=y+'-'+String(m).padStart(2,'0'),ks=Object.keys(all).filter(d=>d.startsWith(k)),a=ks.length?Math.round(ks.reduce((t,d)=>t+pct(d),0)/ks.length):0;
      cols+=`<div class="col"><div class="cb"><i style="height:${a}%"></i></div><small>${new Date(2000,m-1,1).toLocaleDateString('en',{month:'narrow'})}</small></div>`}
    h+=`<div class="card"><h3>${y} · average score by month</h3><div class="cols" style="gap:3px">${cols}</div></div>`}
  return h}

function vMoney(){const it=S.money[mon]||[],s=S.s,inc=sum(it,'in'),out=sum(it,'out'),cats={};
  it.filter(i=>i.t=='out').forEach(i=>cats[i.c||'other']=(cats[i.c||'other']||0)+i.a);
  const cl=Object.entries(cats).sort((a,b)=>b[1]-a[1]),dd=cur.startsWith(mon)?cur:mon+'-01';
  return `<div class="hd"><button data-act="mnav" data-s="-1">‹</button><b>${parse(mon+'-01').toLocaleDateString('en',{month:'long',year:'numeric'})}</b><button data-act="mnav" data-s="1">›</button></div>
  <div class="card grid" style="grid-template-columns:repeat(3,1fr)"><div><b class="in">${fmt(inc)}</b><small>in</small></div><div><b class="out">${fmt(out)}</b><small>spent</small></div><div><b>${fmt(inc-out)}</b><small>balance</small></div></div>
  <div class="card"><div class="row" style="border:0;padding-top:0"><span>Monthly budget (₹)</span><input data-act="cfg" data-k="budget" type="number" value="${s.budget}" style="width:110px"></div>${s.budget>0?`<div class="bar"><i style="width:${Math.min(100,Math.round(100*out/s.budget))}%;${out>s.budget?'background:var(--bad)':''}"></i></div><small>${fmt(out)} of ${fmt(s.budget)}</small>`:''}</div>
  <div class="card"><h3>Add entry</h3><div class="f"><select id="tt"><option value="out">Spent</option><option value="in">Received</option></select><input id="ta" type="number" inputmode="decimal" placeholder="Amount"><input id="tc" list="cl" placeholder="Category"><input id="td" type="date" value="${dd}"><input id="tn" class="w" placeholder="Note (optional)"><button class="pri w" data-act="addtx">Add</button></div>
  <datalist id="cl"><option>Food</option><option>Travel</option><option>Bills</option><option>Study</option><option>Shopping</option><option>Salary</option></datalist></div>
  ${cl.length?`<div class="card"><h3>Where it went</h3>${cl.map(([k,v])=>`<div class="row" style="border:0;padding:4px 0"><span>${esc(k)}</span><span class="mu">${fmt(v)}</span></div>`).join('')}</div>`:''}
  <div class="card"><h3>Entries</h3>${[...it].sort((a,b)=>b.d.localeCompare(a.d)).map(i=>`<div class="row"><span><b class="${i.t}">${i.t=='in'?'+':'−'}${fmt(i.a)}</b> ${esc(i.c||'')}<small>${i.d} ${esc(i.n||'')}</small></span><button data-act="deltx" data-id="${i.id}">✕</button></div>`).join('')||'<p class="mu">Nothing yet.</p>'}</div>
  <p class="mu" style="font-size:13px">${store?'Saved to your local server.':'Server not reachable. Saved in this browser only.'}</p>`}

/* ---- college ---- */
let cv='main',selSem=null,selSub=null,armed=null,A=null,busy='',err='';
const CDEF=()=>({sems:[],subs:[],plan:{}});
const saveCol=()=>save('college',S.c);
const sub=id=>S.c.subs.find(x=>x.id==id);
const semName=id=>(S.c.sems.find(x=>x.id==id)||{}).name||'';
const arm=k=>{if(armed==k){armed=null;return true}armed=k;return false};
const sylP=u=>u.ch.length?Math.round(100*u.ch.filter(c=>c.d).length/u.ch.length):0;
const asgLeft=u=>u.as.filter(a=>!a.d).length;
