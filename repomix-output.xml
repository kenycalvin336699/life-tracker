function planSum(d){const pl=S.c.plan[dk(d)]||[],sd=day(d).sdone||{};return{t:pl.reduce((a,i)=>a+i.h,0),d:pl.filter(i=>sd[i.s]).reduce((a,i)=>a+i.h,0),pl,sd}}
function colTile(){const p=planSum(cur);return `<div class="ic">📚</div><h2>College</h2><div class="pc">${p.t?p.d+'/'+p.t+'h':'—'}</div><small>${p.t?'study today':'set plan'}</small>`}
const hdr=(v,t)=>`<div class="hd"><button data-act="cgo" data-v="${v}">‹ Back</button><b>${t}</b><span style="width:60px"></span></div>`;
function vCollege(){return({main:cMain,sem:cSem,sub:cSub,plan:cPlan}[cv]||cMain)()}
function cMain(){const c=S.c,p=planSum(cur),left=c.subs.filter(u=>u.bl!=2&&asgLeft(u)>0),bls=c.subs.filter(u=>u.bl==1);
  return `<div class="card"><small>COLLEGE · STUDY QUEST</small><div class="big">${p.d}/${p.t}h</div><div class="bar"><i style="width:${p.t?Math.round(100*p.d/p.t):0}%"></i></div>
  ${p.pl.map(i=>{const u=sub(i.s);return u?`<label class="row"><input type="checkbox" data-act="sd" data-s="${u.id}" ${p.sd[i.s]?'checked':''}><span class="${p.sd[i.s]?'dn':''}">${esc(u.n)} · ${i.h}h</span></label>`:''}).join('')||'<p class="mu" style="margin:0">No study planned today.</p>'}
