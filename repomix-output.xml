  else if(a=='padd'){if(c.subs.length){(c.plan[d.d]=c.plan[d.d]||[]).push({s:c.subs[0].id,h:1});saveCol()}}
  else if(a=='pdel'){c.plan[d.d].splice(+d.i,1);saveCol()}
  else if(a=='delf'){if(arm('f'+d.id)){const u=sub(selSub),f=u.fl.find(x=>x.id==d.id);u.fl=u.fl.filter(x=>x.id!=d.id);saveCol();if(A&&f)A.delete(f.a).catch(()=>{})}}
  else if(a=='delsub'){if(arm('sub'+selSub)){const u=sub(selSub);c.subs=c.subs.filter(x=>x.id!=u.id);Object.keys(c.plan).forEach(k=>c.plan[k]=c.plan[k].filter(i=>i.s!=u.id));saveCol();if(A)u.fl.forEach(f=>A.delete(f.a).catch(()=>{}));cv='sem'}}
  else if(a=='delsem'){if(arm('sem'+selSem)){const us=c.subs.filter(u=>u.sem==selSem),ids=us.map(u=>u.id);if(A)us.forEach(u=>u.fl.forEach(f=>A.delete(f.a).catch(()=>{})));c.subs=c.subs.filter(u=>u.sem!=selSem);c.sems=c.sems.filter(m=>m.id!=selSem);Object.keys(c.plan).forEach(k=>c.plan[k]=c.plan[k].filter(i=>!ids.includes(i.s)));saveCol();cv='main'}}
  else return false;
  return true}
function colChange(t,a){const d=t.dataset;
  if(a=='sd'){const sd=Object.assign({},day(cur).sdone||{});sd[d.s]=t.checked;setDay(cur,{sdone:sd})}
