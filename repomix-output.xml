.card,.tile{background:linear-gradient(160deg,rgba(18,42,98,.65),rgba(7,15,40,.8));border:1px solid var(--bd);border-radius:0;padding:14px;margin:0 0 12px;box-shadow:var(--gl);color:var(--tx)}
h3,h2{margin:0 0 8px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--hi);text-shadow:0 0 10px rgba(80,150,255,.7)}
.mu,small{color:var(--mu)}small{display:block;font-size:12px}
.big{font-size:44px;font-weight:800;line-height:1;text-shadow:0 0 16px rgba(80,150,255,.8)}
.bar{position:relative;height:10px;background:rgba(80,130,230,.18);border-radius:0;margin:8px 0}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#2563eb,#38d6ff);border-radius:0;box-shadow:0 0 10px #38d6ff;transition:width .25s}
.bar b{position:absolute;top:-3px;bottom:-3px;width:2px;background:#fff;opacity:.7}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid rgba(70,140,255,.15)}
.row:last-child{border-bottom:0}
label.row{cursor:pointer;justify-content:flex-start}label.row span{flex:1}
input[type=checkbox]{width:22px;height:22px;accent-color:#38d6ff}
.dn{text-decoration:line-through;color:var(--mu)}
input,select,textarea,button{font:inherit;color:var(--tx)}
input,select,textarea{background:rgba(5,12,35,.7);border:1px solid var(--bd);border-radius:0;padding:8px;min-width:0;width:100%}
textarea{min-height:110px;resize:vertical;margin:4px 0 10px}
.row input:not([type=checkbox]){width:auto}
button{background:rgba(20,45,105,.6);border:1px solid var(--bd);border-radius:0;padding:8px 12px;cursor:pointer}
button.pri,.on{background:var(--ac)!important;border-color:var(--ac)!important;color:#fff!important}
.st{display:flex;gap:8px}.st button{flex:1}
.hd{display:flex;align-items:center;justify-content:space-between;margin:2px 0 12px}.hd b{font-size:17px}
.seg,.chips{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}.seg button{flex:1;text-transform:capitalize}.chips button{flex:1;padding:8px 4px}
.tiles{display:grid;gap:12px}
@media(min-width:700px){.tiles{grid-template-columns:repeat(3,1fr)}}
.tile{text-align:left;width:100%;margin:0}
.tile .ic{font-size:26px}.tile .pc{font-size:34px;font-weight:800;text-shadow:0 0 14px rgba(80,150,255,.8)}
.lock{opacity:.55;border-style:dashed}
.lv{font-size:26px;font-weight:800;letter-spacing:.1em;text-shadow:0 0 14px rgba(80,150,255,.9)}
.cols{display:flex;gap:6px;align-items:flex-end}.col{flex:1;text-align:center}
.cb{height:110px;background:rgba(80,130,230,.15);border-radius:0;display:flex;align-items:flex-end;overflow:hidden}.cb i{display:block;width:100%;background:linear-gradient(0deg,#2563eb,#38d6ff)}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;text-align:center}.grid b{font-size:20px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.cal div{aspect-ratio:1;border-radius:0;font-size:12px;display:flex;align-items:center;justify-content:center;background:rgba(80,130,230,.15)}.cal .h{background:none;aspect-ratio:auto;color:var(--mu)}
.in{color:var(--ok)}.out{color:var(--bad)}
.f{display:grid;grid-template-columns:1fr 1fr;gap:8px}.f .w{grid-column:1/3}
nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:rgba(6,11,31,.92);border-top:1px solid var(--bd);padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px))}
nav button{flex:1;border:0;background:none;padding:10px 4px;color:var(--mu);font-size:14px}
nav button.on{background:none!important;color:var(--ok)!important;font-weight:700;text-shadow:0 0 10px #38d6ff}
.card,.tile{position:relative;border:1px solid rgba(80,150,255,.55)}
.card::before,.tile::before{content:"";position:absolute;top:-1px;left:-1px;width:12px;height:12px;border-top:2px solid var(--ok);border-left:2px solid var(--ok);pointer-events:none}
.card::after,.tile::after{content:"";position:absolute;bottom:-1px;right:-1px;width:12px;height:12px;border-bottom:2px solid var(--ok);border-right:2px solid var(--ok);pointer-events:none}
body{font-family:"Rajdhani","Bahnschrift","Arial Narrow",system-ui,sans-serif;font-size:17px;font-weight:500}
h3,h2{font-weight:700;letter-spacing:.18em}
.tiles{grid-template-columns:repeat(3,1fr)!important;gap:8px}
.tile{padding:10px 6px;text-align:center}.tile .ic{font-size:20px}.tile h2{font-size:11px;margin:2px 0 4px}.tile .pc{font-size:20px}
.btn{display:inline-block;background:rgba(20,45,105,.6);border:1px solid var(--bd);padding:8px 12px;cursor:pointer;margin-top:6px}
select{min-width:0}a{text-decoration:none}
nav button{font-size:13px;padding:10px 2px}
.tiles{grid-template-columns:repeat(4,1fr)!important;gap:6px}
.tile{padding:8px 3px}.tile h2{font-size:10px;letter-spacing:.08em}.tile .pc{font-size:17px}.tile small{font-size:10px}
nav button{font-size:11px;padding:10px 0;letter-spacing:0}
.sys{overflow:hidden}
.sysrow{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap}.sysl{flex:1;min-width:150px}
.rank{display:inline-block;font-size:34px;font-weight:800;line-height:1.1;border:2px solid var(--ok);padding:0 12px;color:var(--ok);text-shadow:0 0 14px #38d6ff;box-shadow:0 0 14px rgba(56,214,255,.5),inset 0 0 12px rgba(56,214,255,.25);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{50%{box-shadow:0 0 26px rgba(56,214,255,.9),inset 0 0 16px rgba(56,214,255,.4)}}
.xpb i{position:relative;overflow:hidden}.xpb i::after{content:"";position:absolute;top:0;bottom:0;width:40%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);animation:shine 2.2s linear infinite}
@keyframes shine{from{left:-40%}to{left:100%}}
.stats{display:grid;grid-template-columns:auto 1fr;gap:2px 12px;margin-top:8px;font-size:14px}.stats span{color:var(--mu);letter-spacing:.12em}
.radar{filter:drop-shadow(0 0 6px rgba(56,214,255,.6))}
#lvup{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;background:rgba(3,8,24,.88);z-index:20;font-size:38px;letter-spacing:.2em;color:var(--ok);text-shadow:0 0 24px #38d6ff;text-align:center}
#lvup.on{display:flex}
.cal button{aspect-ratio:1;padding:0;font-size:13px;background:rgba(80,130,230,.15);border:1px solid transparent}
.cal button.has{background:rgba(59,130,255,.5);font-weight:700}.cal button.tod{text-decoration:underline}
.cal button.sel{border-color:var(--ok);box-shadow:0 0 10px var(--ok)}
.acc{padding:12px 14px}
.acch{display:flex;width:100%;align-items:center;gap:10px;background:none;border:0;padding:0;text-align:left;cursor:pointer}
.acch b{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--hi);text-shadow:0 0 10px rgba(80,150,255,.7);font-weight:700}
.acch .sm{margin-left:auto;color:var(--mu);font-size:13px;text-align:right}
.acch .ar{color:var(--ok);width:14px;text-align:center}
.accb{margin-top:10px}
</style></head>
<body>
<main id="v"><p class="mu">Loading…</p></main>
<nav id="nav"></nav>
<div id="lvup"></div>
<div id="off" style="display:none;position:fixed;left:0;right:0;top:0;background:#7a1730;color:#fff;text-align:center;padding:4px;font-size:13px;z-index:9">Server offline. Changes will save when it is back.</div>
<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const parse=s=>{const[a,b,c]=s.split('-').map(Number);return new Date(a,b-1,c)};
const addD=(s,n)=>{const d=parse(s);d.setDate(d.getDate()+n);return iso(d)};
const shiftMon=(m,n)=>{const[y,mo]=m.split('-').map(Number);return iso(new Date(y,mo-1+n,1)).slice(0,7)};
const fmt=n=>'₹'+Math.round(n).toLocaleString('en-IN');
const uid0=()=>Math.random().toString(36).slice(2,8);
const DAYS=['sun','mon','tue','wed','thu','fri','sat'],ORDER=['mon','tue','wed','thu','fri','sat','sun'],DN={sun:'Sunday',mon:'Monday',tue:'Tuesday',wed:'Wednesday',thu:'Thursday',fri:'Friday',sat:'Saturday'};
let cur=iso(new Date()),tab='home',rng='week',mon=cur.slice(0,7),store=null,editing=false,editDay='mon';
const S={s:null,days:{},money:{},p:{}};
const DEF=()=>{const ex={},fd={};DAYS.forEach(k=>{ex[k]=k=='sun'?['Rest']:['Warm-up','Workout','Stretch'];fd[k]=['Breakfast','Lunch','Snack','Dinner']});return{wake:'05:30',sleep:'22:00',wmin:2,wmax:3,protein:100,budget:0,ex,fd}};
const dk=d=>DAYS[parse(d).getDay()];
const isRest=l=>l.length>0&&/^rest/i.test(l[0]);
const tm=t=>{const[h,m]=t.split(':').map(Number);return(h%12||12)+':'+String(m).padStart(2,'0')+(h<12?' AM':' PM')};
const lines=v=>v.split('\n').map(x=>x.trim()).filter(Boolean);

async function init(){try{const r=await fetch('/api/ping');store=r.ok}catch(e){}
  A={upload:async f=>{const r=await fetch('/api/files',{method:'POST',headers:{'Content-Type':f.type||'application/pdf','X-Filename':encodeURIComponent(f.name)},body:f});if(!r.ok)throw new Error('upload');return r.json()},delete:id=>fetch('/api/files/'+id,{method:'DELETE'})}}
async function load(n,def){try{const r=await fetch('/api/doc/'+n);if(r.status==404)return def;if(r.ok)return await r.json()}catch(e){}try{const v=localStorage.getItem('lt:'+n);return v?JSON.parse(v):def}catch(e){return def}}
const timers={},pend={};
function banner(){const b=$('#off');if(b)b.style.display=Object.keys(pend).length?'block':'none'}
function flush(){Object.keys(pend).forEach(n=>{const o=pend[n];fetch('/api/doc/'+n,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(o)}).then(r=>{if(!r.ok)throw 0;if(pend[n]===o)delete pend[n];banner()}).catch(banner)});banner()}
function save(n,o){try{localStorage.setItem('lt:'+n,JSON.stringify(o))}catch(e){}pend[n]=o;clearTimeout(timers[n]);timers[n]=setTimeout(flush,400)}
setInterval(()=>{if(Object.keys(pend).length)flush()},5000);
document.addEventListener('visibilitychange',()=>{if(document.hidden){Object.keys(timers).forEach(k=>clearTimeout(timers[k]));flush()}});
const ensureYear=async y=>{if(!S.days[y])S.days[y]=(await load('days-'+y,{days:{}})).days||{}};
const ensureMon=async m=>{if(!S.money[m])S.money[m]=(await load('money-'+m,{items:[]})).items||[]};
const saveDays=y=>save('days-'+y,{days:S.days[y]}),saveMoney=m=>save('money-'+m,{items:S.money[m]}),saveSet=()=>save('health',S.s);

const day=d=>(S.days[d.slice(0,4)]||{})[d]||{};
function setDay(d,p){const y=d.slice(0,4);S.days[y]=S.days[y]||{};const o=S.days[y][d]||{done:{}};if(!o.done)o.done={};S.days[y][d]=Object.assign(o,p);saveDays(y)}
function legacyPlan(d){const s=S.s,k=dk(d),ex=s.ex[k]||[],rest=!ex.length||/^rest/i.test(ex[0]);
  return{wake:s.wake,sleep:s.sleep,wmin:s.wmin,wmax:s.wmax,protein:s.protein,rest,ex:rest?[]:ex.slice(),fd:(s.fd[k]||[]).slice(),
    study:((S.c.plan||{})[k]||[]).map(i=>({s:i.s,h:i.h,nm:(sub(i.s)||{}).n||i.nm||''})),
    self:S.f.topics.filter(x=>((x.sch||{})[k]||{}).h>0).map(x=>({id:x.id,n:x.n,h:x.sch[k].h,at:x.sch[k].at||''}))}}

function freezeSync(){const t=iso(new Date());for(const yy in S.days){const all=S.days[yy];let ch=false;for(const d in all)if(d<t&&!all[d].fz){all[d].fz=legacyPlan(d);ch=true}if(ch)saveDays(yy)}}
function items(d){const P=plan(d);return[{k:'wake'},{k:'sleep'},...P.ex.map(t=>({k:'e:'+t})),...P.fd.map(t=>({k:'f:'+t}))]}
function pct(d){const x=day(d),dn=x.done||{},it=items(d),P=plan(d);return Math.round(100*(it.filter(i=>dn[i.k]).length+((x.water||0)>=P.wmin?1:0))/(it.length+1))}
function streak(){let d=cur,n=0;if(pct(d)<80)d=addD(d,-1);while(n<400&&pct(d)>=80){n++;d=addD(d,-1)}return n}
function xp(){let x=0;for(const y in S.days)for(const d in S.days[y]){const o=S.days[y][d];x+=(Object.values(o.done||{}).filter(Boolean).length+Object.values(o.sdone||{}).filter(Boolean).length+Object.values(o.pdone||{}).filter(Boolean).length)*10;if((o.water||0)>=plan(d).wmin)x+=10}return x}
const sum=(it,t)=>it.filter(i=>i.t==t).reduce((a,i)=>a+i.a,0);

const chk=(k,l,dn)=>`<label class="row"><input type="checkbox" data-act="chk" data-k="${esc(k)}" ${dn[k]?'checked':''}><span class="${dn[k]?'dn':''}">${esc(l)}</span></label>`;
function meter(k,l,u,steps,v,goal,min){const p=Math.min(100,Math.round(100*v/goal));
  return `<div class="row" style="border:0;padding-bottom:0"><span>${l}</span><span class="mu">${+v.toFixed(2)} / ${goal} ${u}</span></div><div class="bar"><i style="width:${p}%"></i>${min?`<b style="left:${100*min/goal}%"></b>`:''}</div><div class="st">${steps.map(s=>`<button data-act="step" data-k="${k}" data-s="${s}">${s>0?'+':'−'} ${Math.abs(s)}</button>`).join('')}</div>`}

function dstat(d){const x=day(d),dn=x.done||{},P=plan(d),fr=(a,pre)=>a.length?a.filter(t=>dn[pre+t]).length/a.length:null,foods=fr(P.fd,'f:'),w=(x.water||0)>=P.wmin?1:0,sp=planSum(d),se=selfPlan(d);
  return{str:P.rest?null:fr(P.ex,'e:'),vit:foods==null?w:(foods+w)/2,agi:(['wake','sleep'].filter(k=>dn[k]).length)/2,int:sp.t?sp.d/sp.t:null,sen:se.t?se.d/se.t:null}}
function statusBox(){const X=xp(),lv=Math.floor(X/200)+1,ps=[...Array(7)].map((_,i)=>dstat(addD(cur,i-6)));
  const av=k=>{const v=ps.map(o=>o[k]).filter(z=>z!=null);return v.length?Math.round(100*v.reduce((a,b)=>a+b,0)/v.length):0};
  const st=[['STR',av('str')],['VIT',av('vit')],['AGI',av('agi')],['INT',av('int')],['SEN',av('sen')]],rank=lv>=30?'S':lv>=20?'A':lv>=15?'B':lv>=10?'C':lv>=5?'D':'E';
  const R=62,C=80,pt=(i,v)=>{const a=(-90+i*72)*Math.PI/180;return[(C+R*v*Math.cos(a)).toFixed(1),(C+R*v*Math.sin(a)).toFixed(1)]};
  const poly=st.map((q,i)=>pt(i,Math.max(.06,q[1]/100)).join(',')).join(' '),grid=[.33,.66,1].map(g=>`<polygon points="${st.map((_,i)=>pt(i,g).join(',')).join(' ')}" fill="none" stroke="rgba(80,150,255,.3)"/>`).join(''),
    ax=st.map((q,i)=>{const[a,b]=pt(i,1.3);return `<text x="${a}" y="${b}" fill="#7fb4ff" font-size="10" text-anchor="middle" dominant-baseline="middle">${q[0]}</text>`}).join('');
  return `<div class="card sys"><small>SYSTEM · PLAYER STATUS</small><div class="sysrow"><div class="sysl"><div class="rank">${rank}</div> <small style="display:inline">RANK</small><div class="lv">LEVEL ${lv}</div><div class="bar xpb"><i style="width:${(X%200)/2}%"></i></div><small>${X%200} / 200 XP · ${streak()} day streak</small>
  <div class="stats">${st.map(q=>`<span>${q[0]}</span><b>${q[1]}</b>`).join('')}</div></div>
  <svg viewBox="-14 -14 188 188" width="150" height="150" class="radar">${grid}${ax}<polygon points="${poly}" fill="rgba(56,214,255,.28)" stroke="#38d6ff" stroke-width="1.5"/></svg></div><small>Stats = your last 7 days up to this date</small></div>`}
function lvCheck(){const lv=Math.floor(xp()/200)+1;let o=0;try{o=+localStorage.getItem('lt:lv')||0;if(lv>o)localStorage.setItem('lt:lv',lv)}catch(e){}
  if(o&&lv>o){const e=$('#lvup');e.innerHTML='LEVEL UP!<small style="font-size:16px;letter-spacing:.2em">LEVEL '+lv+'</small>';e.classList.add('on');setTimeout(()=>e.classList.remove('on'),2800)}}
function plannedAhead(){const t=iso(new Date());let n=0;for(const y in S.p)for(const d in S.p[y])if(d>=t&&hasP(S.p[y][d]))n++;return n}
function vHome(){const p=pct(cur),x=day(cur),pl=plan(cur),td=pl.td,tn=x.tdone||{};
  return statusBox()+`<div class="tiles">
  <button class="tile" data-act="go" data-t="health"><div class="ic">❤️</div><h2>Health</h2><div class="pc">${p}%</div><small>${+(x.water||0).toFixed(1)}/${pl.wmax} L</small></button>
  <button class="tile" data-act="go" data-t="college">${colTile()}</button>
  <button class="tile" data-act="go" data-t="self">${selfTile()}</button>
  <button class="tile" data-act="go" data-t="plan"><div class="ic">🗓️</div><h2>Plan</h2><div class="pc">${plannedAhead()}</div><small>days ahead</small></button></div>`
  +(td.length?`<div class="card" style="margin-top:12px"><h3>Tasks · ${dlabel(cur)}</h3>${td.map(t=>`<label class="row"><input type="checkbox" data-act="tkd" data-t="${esc(t)}" ${tn[t]?'checked':''}><span class="${tn[t]?'dn':''}">${esc(t)}</span></label>`).join('')}</div>`:'')}

function vHealth(){const x=day(cur),s=plan(cur),dn=x.done||{},p=pct(cur),w=x.water||0,
  nd=(a,pre)=>a.filter(t=>dn[pre+t]).length;
  return `<div class="card"><small>HEALTH · DAILY QUEST</small><div class="big">${p}%</div><div class="bar"><i style="width:${p}%"></i></div><small>${dlabel(cur)}</small></div>`
  +acc('h-routine','Routine',`${['wake','sleep'].filter(k=>dn[k]).length}/2 done`,`${chk('wake','Wake up at '+tm(s.wake),dn)}<div class="row"><span class="mu">Actual wake-up time</span><input type="time" data-act="wake" value="${x.wake||''}"></div>${chk('sleep','Sleep by '+tm(s.sleep),dn)}`)
  +acc('h-water','Water',`${w>=s.wmin?'✓ ':''}${+w.toFixed(2)} / ${s.wmax} L`,meter('water','Water ('+s.wmin+' to '+s.wmax+' L a day)','L',[-0.25,0.25,0.5],w,s.wmax,s.wmin))
  +acc('h-ex','Exercise',s.rest?'Rest day':(s.ex.length?`${nd(s.ex,'e:')}/${s.ex.length} done`:'none planned'),s.rest?'<p class="mu" style="margin:0">Rest day. Recover and stretch lightly.</p>':(s.ex.map(t=>chk('e:'+t,t,dn)).join('')||'<p class="mu" style="margin:0">Nothing planned for this date.</p>'))
  +acc('h-food','Food',`${s.fd.length?nd(s.fd,'f:')+'/'+s.fd.length+' · ':''}${x.protein||0} g protein`,`${s.fd.map(t=>chk('f:'+t,t,dn)).join('')||'<p class="mu" style="margin:0">No meals planned.</p>'}<div style="height:8px"></div>${meter('protein','Protein','g',[-10,10,25],x.protein||0,s.protein)}`)
  +`<button class="pri" style="width:100%" data-act="pedit" data-d="${cur}">Plan this date</button>`}

function vStats(){let h=`<div class="seg">${['week','month','year'].map(r=>`<button data-act="rng" data-r="${r}" class="${rng==r?'on':''}">${({week:'7 days',month:'month',year:'year'})[r]}</button>`).join('')}</div>`;
  if(rng=='week'){const ds=[...Array(7)].map((_,i)=>addD(cur,i-6)),a=k=>Math.round(ds.reduce((t,d)=>t+(day(d)[k]||0),0)/7*10)/10;
    h+=`<div class="card"><h3>Last 7 days</h3><div class="cols">${ds.map(d=>`<div class="col"><div class="cb"><i style="height:${pct(d)}%"></i></div><small>${parse(d).toLocaleDateString('en',{day:'numeric',month:'short'})}</small><small>${pct(d)}%</small></div>`).join('')}</div></div>
    <div class="card grid"><div><b>${Math.round(ds.reduce((t,d)=>t+pct(d),0)/7)}%</b><small>avg score</small></div><div><b>${a('water')}</b><small>avg water L</small></div><div><b>${a('protein')}</b><small>avg protein g</small></div><div><b>${streak()}</b><small>day streak</small></div></div>`;
  }else if(rng=='month'){const m=cur.slice(0,7),f=parse(m+'-01'),n=new Date(f.getFullYear(),f.getMonth()+1,0).getDate(),off=(f.getDay()+6)%7;let c='',t=0;
    ['M','T','W','T','F','S','S'].forEach(w=>c+=`<div class="h">${w}</div>`);for(let i=0;i<off;i++)c+='<div class="h"></div>';
    for(let i=1;i<=n;i++){const d=m+'-'+String(i).padStart(2,'0'),p=pct(d);t+=p;c+=`<div style="background:color-mix(in srgb,#38d6ff ${p}%,rgba(80,130,230,.15))">${i}</div>`}
